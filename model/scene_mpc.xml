<mujoco model="g1_29dof_mpc scene">
  <include file="g1_29dof_mpc.xml"/>

  <statistic center="0 0 0.8" extent="1.4" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-20" offwidth="1280" offheight="720"/>
    <map force="0.005"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>

    <camera name="track" mode="trackcom" pos="0 -3.5 0.15"    xyaxes="1 0 0 0 0 1"/>
    <camera name="side"  mode="trackcom" pos="-3.5 0 0.15"    xyaxes="0 -1 0 0 0 1"/>
    <camera name="diag"  mode="trackcom" pos="-2.5 -2.5 0.15" xyaxes="1 -1 0 0 0 1"/>
    <!-- contype/conaffinity 1: collides with the robot's contype=2/conaffinity=1 geoms -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          contype="1" conaffinity="1" condim="3" friction="1 0.005 0.0001"/>
  </worldbody>
</mujoco>
